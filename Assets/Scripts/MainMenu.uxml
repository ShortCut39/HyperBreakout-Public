<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Hyper-Breakout" name="GameName" style="align-items: auto; align-self: center; top: 5%; color: rgb(255, 255, 255); border-top-color: rgb(255, 0, 211); border-left-color: rgb(255, 0, 211); border-bottom-color: rgb(255, 0, 211); border-right-color: rgb(255, 0, 211); border-bottom-width: 5px; border-left-width: 5px; border-top-width: 5px; border-right-width: 5px; border-bottom-left-radius: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; font-size: 30px;"/>
    <ui:Button text="Start" name="StartButton" style="top: 25%; align-self: center; align-items: auto; -unity-text-align: middle-center; justify-content: flex-start; -unity-font-style: bold; color: rgb(46, 255, 0);"/>
    <ui:Button text="Exit" name="ExitButton" style="top: 50%; align-self: center; -unity-font-style: bold; color: rgb(255, 0, 0);"/>
</ui:UXML>
